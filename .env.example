###############################################################################
# SabIT — Konfigurasi Environment
###############################################################################
# Copy file ini ke `.env` lalu isi nilai yang sesuai dengan environment Anda.
#   cp .env.example .env
#   php artisan key:generate
#
# Setiap section punya komentar yang menjelaskan kapan harus diisi.
# Nilai default (kosong) aman untuk development lokal; production WAJIB diisi.
###############################################################################


# -----------------------------------------------------------------------------
# 1. APLIKASI
# -----------------------------------------------------------------------------
APP_NAME="SAbIT"
APP_ENV=production                     # local | production
APP_KEY=                               # Jalankan: php artisan key:generate
APP_DEBUG=false                        # WAJIB false di production (jangan pernah true!)
APP_URL=https://al-maruf.sch.id        # URL publik aplikasi. Digunakan oleh asset(),
                                       # email link, dan sebagai fallback URL generator.
                                       # PENTING: pakai https di production.


# -----------------------------------------------------------------------------
# 2. MULTI-TENANT (Stancl Tenancy)
# -----------------------------------------------------------------------------
# Central domain = aplikasi pusat (Tenant Console) tempat admin pusat
# mengelola daftar sekolah. SEKOLAH TIDAK masuk sini — didaftarkan via
# tabel `domains` di DB central (lihat section 3 di bawah).
#
# Contoh setup production:
#   Single-domain:   CENTRAL_DOMAIN=al-maruf.sch.id
#   Subdomain app:   CENTRAL_DOMAIN=app.al-maruf.com
#                    CENTRAL_BASE_DOMAIN=al-maruf.com
#                    TENANT_BASE_DOMAIN=al-maruf.com
#
# Contoh setup local (Laragon, multi-subdomain):
#   CENTRAL_DOMAIN=pusat.sabit.test
#   CENTRAL_BASE_DOMAIN=sabit.test
#   TENANT_BASE_DOMAIN=sabit.test
CENTRAL_DOMAIN=
CENTRAL_BASE_DOMAIN=

# Session cookie domain. Set ke ".your-domain.com" (dengan leading dot) bila
# subdomain berbagi session. Kosongkan untuk single-domain / setiap sekolah
# punya session sendiri.
SESSION_DOMAIN=

# DB prefix untuk tenant. Setiap DB sekolah = <prefix><tenant_id>,
# contoh: sabit_demo, sabit_sma1. JANGAN diubah setelah go-live kecuali
# Anda siap migrasi semua data tenant.
TENANT_DB_PREFIX=sim_akademik_

# Tangkap fatal error ke file khusus (untuk debug request yang return 500).
ENABLE_FATAL_CAPTURE=1


# -----------------------------------------------------------------------------
# 3. CARA MENDAFTARKAN SEKOLAH BARU
# -----------------------------------------------------------------------------
# Setiap sekolah punya domain sendiri. Daftarkan via SQL ke tabel `domains`
# pada database central, atau via panel pusat (Tenant Console).
#
# Struktur tabel `domains`:
#   domain       VARCHAR  -- FQDN sekolah, mis. al-islam.sch.id
#   type         ENUM     -- 'admin' (panel sekolah) | 'landing' (halaman publik)
#   tenant_id    VARCHAR  -- id tenant di tabel `tenants`
#
# Contoh tambah sekolah "Al-Islam":
#   INSERT INTO domains (domain, type, tenant_id) VALUES
#     ('al-islam.sch.id',       'admin',   'islam'),
#     ('al-islam.land',         'landing', 'islam');
#
# Setelah tambah domain, flush cache:
#   php artisan cache:clear
#
# Tiap sekolah OTOMATIS punya:
#   https://al-islam.sch.id/login        -> login admin sekolah
#   https://al-islam.land/               -> landing page publik


# -----------------------------------------------------------------------------
# 4. LOG
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info                          # debug | info | notice | warning | error


# -----------------------------------------------------------------------------
# 5. DATABASE — Central (aplikasi pusat & tabel `tenants`, `domains`)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabit                       # Nama DB central. Berisi tabel users,
                                        # tenants, domains, dan lain-lain.
DB_USERNAME=root
DB_PASSWORD=

# Tenant DB dibuat via Stancl saat TenantCreated event. Prefix di atas yang
# menentukan nama DB tenant. Tidak perlu isi DB_TENANT_HOST di sini.


# -----------------------------------------------------------------------------
# 6. CACHE / SESSION / QUEUE / FILESYSTEM
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=database                  # Disimpan di tabel `cache` DB central.
SESSION_DRIVER=database                # Disimpan di tabel `sessions` DB central.
SESSION_LIFETIME=120                   # menit
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync                  # Untuk antrian job. Pakai 'redis' di
                                        # production kalau volume tinggi.

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# 7. MAIL (untuk notifikasi, reset password, dll)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls                     # tls untuk 587, ssl untuk 465
MAIL_FROM_ADDRESS="no-reply@al-maruf.sch.id"
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# 8. AWS S3 (opsional, untuk file storage skala besar)
# -----------------------------------------------------------------------------
# Kosongkan jika pakai FILESYSTEM_DISK=local (default).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------------
# 9. PUSHER (opsional, untuk realtime notifikasi)
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


###############################################################################
# CHECKLIST SEBELUM GO-LIVE PRODUCTION
###############################################################################
# [ ] APP_ENV=production
# [ ] APP_DEBUG=false
# [ ] APP_URL pakai https
# [ ] APP_KEY sudah di-generate
# [ ] CENTRAL_DOMAIN di-set ke domain pusat
# [ ] Setiap sekolah punya entry di tabel `domains`
# [ ] Database central & setiap tenant sudah di-backup
# [ ] DB_PASSWORD kuat (ganti 'root' / kosong)
# [ ] SESSION_DRIVER=database dan tabel `sessions` ada
# [ ] CACHE_DRIVER=database dan tabel `cache` ada
# [ ] chmod 600 .env
# [ ] Web server (Apache/Nginx) sudah bisa serve https
# [ ] DNS wildcard *.al-maruf.com pointing ke server (kalau pakai subdomain)
# [ ] SSL certificate valid (Let's Encrypt atau commercial)
# [ ] php artisan optimize:clear && php artisan config:cache
# [ ] Test login dari setiap domain sekolah
###############################################################################
